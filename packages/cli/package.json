{
  "name": "notdownhub",
  "version": "0.0.1",
  "description": "Run unmodified GitHub Actions CI on your own infrastructure — local repos, your own servers, remote runner fleets. No hub required.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtai/notdownhub.git",
    "directory": "packages/cli"
  },
  "homepage": "https://notdownhub.com",
  "bugs": {
    "url": "https://github.com/davidtai/notdownhub/issues"
  },
  "keywords": [
    "ci",
    "github-actions",
    "self-hosted",
    "runner",
    "workflows",
    "offline"
  ],
  "type": "module",
  "bin": {
    "ndh": "dist/index.js"
  },
  "files": [
    "dist",
    "ui-dist",
    "!dist/test",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-bin-executable.mjs",
    "prepublishOnly": "npm run build && node --input-type=module -e \"import { accessSync, constants } from 'node:fs'; accessSync('dist/index.js', constants.X_OK);\"",
    "test": "c8 --check-coverage node --import ./dist/test/_setup.js --test \"dist/test/**/*.test.js\"",
    "test:nocov": "node --import ./dist/test/_setup.js --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "c8": "^10.1.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.6.1"
  }
}
